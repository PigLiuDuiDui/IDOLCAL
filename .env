# ============================================================
# IdolCal 本地运行配置（.env）
# 由 Marvis 基于 .env.example 生成，仅填了本地可跑的最小必填项
# 其余变量沿用 application.yml 默认值，按需自行补充
# ============================================================

# 运行环境：dev 放开 H2 控制台 + 放宽校验，本地调试最省心
SPRING_PROFILES_ACTIVE=dev

# 数据库：留空即使用默认 H2 文件库，本地无需 PostgreSQL
IDOLCAL_DB_URL=
IDOLCAL_DB_DRIVER=
IDOLCAL_DB_USERNAME=sa
IDOLCAL_DB_PASSWORD=
IDOLCAL_H2_CONSOLE=true

# Redis：未配置时自动降级内存实现，本地可跑
IDOLCAL_REDIS_HOST=localhost
IDOLCAL_REDIS_PORT=6379
IDOLCAL_REDIS_PASSWORD=

# 功能开关
IDOLCAL_RATE_LIMIT_ENABLED=true
IDOLCAL_CACHE_ENABLED=true
IDOLCAL_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# 管理后台认证
IDOLCAL_AUTH_ENABLED=true
# JWT 密钥（本地生成，48 字节随机值，满足 ≥32 字节要求）
IDOLCAL_JWT_SECRET=yiJwt4yeLGWUSGr24B2fDVG0gRwm4yrmZoZdVYFfbgQufXMNrmsFop7f1y0bePf5
IDOLCAL_JWT_TTL_HOURS=24
# 本地用 dev profile 已放宽校验；若切回生产 strict 模式，此密钥已满足长度要求
IDOLCAL_AUTH_STRICT_JWT_SECRET=true
IDOLCAL_ADMIN_USERNAME=admin
# 本地管理员密码（请按需修改）
IDOLCAL_ADMIN_PASSWORD=idolcal-local-admin-2026
IDOLCAL_AUTH_LOGIN_MAX_FAILURES=5
IDOLCAL_AUTH_LOGIN_LOCK_MINUTES=15

# Web Push
IDOLCAL_PUSH_SEND_CONCURRENCY=8
IDOLCAL_PUSH_FANOUT_BATCH_SIZE=500
IDOLCAL_PUSH_PROCESSING_TIMEOUT_MS=600000
IDOLCAL_PUSH_LOG_RETENTION_DAYS=90

# VAPID 密钥：本地留空，回退读取 api/.vapid-keys（开发用，勿提交）
# 如需环境变量注入，运行 node scripts/gen-vapid.mjs 生成后填入下方
IDOLCAL_VAPID_PUBLIC_KEY=
IDOLCAL_VAPID_PRIVATE_KEY=
IDOLCAL_VAPID_SUBJECT=mailto:admin@idolcal.app

# 前端：cpolar 内网穿透访问 dev server 时允许的 Host（逗号分隔）；
# 支持 .cpolar.top 前缀点通配——cpolar 免费隧道每次启动随机子域，通配后无需反复改
VITE_ALLOWED_HOSTS=431503bc.r38.cpolar.top,.cpolar.top
