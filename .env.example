# ============================================================
# IdolCal 环境变量模板（.env.example）
# 用法：
#   1. 复制为 .env（或直接在部署环境导出为真实环境变量）
#      cp .env.example .env
#   2. 后端（Spring Boot）通过环境变量读取；前端 Vite 通过
#      process.env 读取（需 VITE_ 前缀且构建时注入）
#   3. 标注 [必填] 的变量未配置时应用会拒绝启动（strict 模式）
# ------------------------------------------------------------
# 生成说明：以下变量名均提取自
#   api/src/main/resources/application.yml
#   api/src/main/resources/application-dev.yml
#   vite.config.js
#   api/src/main/java/com/example/bim/api/config/VapidKeys.java
# ============================================================

# ------------------------------------------------------------
# 运行环境 / Profile
# ------------------------------------------------------------
# 后端 profile：dev 开放 H2 控制台 + 放宽 JWT/管理员校验；生产勿用
# 可选值：dev / 留空（默认即生产安全配置）
SPRING_PROFILES_ACTIVE=

# ------------------------------------------------------------
# 数据库（默认 H2 文件库；生产切换 PostgreSQL）
# ------------------------------------------------------------
# PostgreSQL 连接串（生产 [必填]；开发默认 H2 可留空）
# 示例：jdbc:postgresql://db.example.com:5432/idolcal
IDOLCAL_DB_URL=
# 生产 [必填，配合 IDOLCAL_DB_URL]：org.postgresql.Driver
IDOLCAL_DB_DRIVER=
# 数据库用户名（默认 H2 为 sa）
IDOLCAL_DB_USERNAME=sa
# 数据库密码（生产 [必填]）
IDOLCAL_DB_PASSWORD=

# H2 控制台开关（仅调试用，生产必须 false）
# 可选：true / false
IDOLCAL_H2_CONSOLE=false

# ------------------------------------------------------------
# Redis（限流计数 + 热门接口缓存；未配置时自动降级内存实现）
# ------------------------------------------------------------
IDOLCAL_REDIS_HOST=localhost
IDOLCAL_REDIS_PORT=6379
# Redis 密码（无密码留空）
IDOLCAL_REDIS_PASSWORD=

# ------------------------------------------------------------
# 功能开关
# ------------------------------------------------------------
# 限流：按 IP+路径规则计数，超限返回 429
IDOLCAL_RATE_LIMIT_ENABLED=true
# 缓存：/api/events、/api/meta 短 TTL 缓存（管理写操作自动失效）
IDOLCAL_CACHE_ENABLED=true
# 允许跨域的前端来源（逗号分隔）；生产同域部署（Nginx 反代）时设为空
IDOLCAL_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ------------------------------------------------------------
# 管理后台认证（JWT）
# ------------------------------------------------------------
# 认证总开关：false 关闭全部鉴权（仅用于本地调试，生产必须 true）
IDOLCAL_AUTH_ENABLED=true
# JWT 密钥（生产 [必填]，≥32 字节；strict 模式未配置将拒绝启动）
# 生成示例：openssl rand -base64 48
IDOLCAL_JWT_SECRET=
# JWT 有效期（小时）
IDOLCAL_JWT_TTL_HOURS=24
# strict 模式：true 时未配置密钥或密钥 <32 字节直接拒绝启动（生产推荐 true）
IDOLCAL_AUTH_STRICT_JWT_SECRET=true
# 管理员账号（启动器创建）
IDOLCAL_ADMIN_USERNAME=admin
# 管理员密码（生产 [必填]；strict 模式未配置将拒绝启动）
IDOLCAL_ADMIN_PASSWORD=
# 登录连续失败锁定（按 用户名+IP）：失败次数 / 锁定时长（分钟）
IDOLCAL_AUTH_LOGIN_MAX_FAILURES=5
IDOLCAL_AUTH_LOGIN_LOCK_MINUTES=15

# ------------------------------------------------------------
# Web Push 推送
# ------------------------------------------------------------
# 同一任务的订阅并发发送数（万人级压测后调整）
IDOLCAL_PUSH_SEND_CONCURRENCY=8
# Fan-out 分批大小：一个调度触发时按此大小分页处理设备任务
IDOLCAL_PUSH_FANOUT_BATCH_SIZE=500
# PROCESSING 超时阈值（毫秒）：卡住超过该时长被重置重跑
IDOLCAL_PUSH_PROCESSING_TIMEOUT_MS=600000
# 投递日志保留天数：每日凌晨清理更早日志
IDOLCAL_PUSH_LOG_RETENTION_DAYS=90

# ------------------------------------------------------------
# VAPID 密钥（Web Push 签名，RFC 8292）— [必填，二选一]
# ------------------------------------------------------------
# 推荐方式：环境变量注入（生产）
# 公钥 = base64url(SEC1 65 字节)，私钥 = base64url(32 字节标量)
# 兼容方式：未设置时回退读取本地文件 api/.vapid-keys（仅限开发，勿提交）
IDOLCAL_VAPID_PUBLIC_KEY=
IDOLCAL_VAPID_PRIVATE_KEY=
# VAPID 联系人（推送服务校验用，格式 mailto: 或 https://）
IDOLCAL_VAPID_SUBJECT=mailto:admin@idolcal.app
#
# VAPID 密钥生成方式（任选其一）：
#   a) 项目自带脚本：node scripts/gen-vapid.mjs
#      （生成 api/.vapid-keys 文件，并打印可直接 export 的环境变量）
#   b) 在线生成：https://web-push-codelab.glitch.me/
# 生成的公钥/私钥填入上方 IDOLCAL_VAPID_PUBLIC_KEY / IDOLCAL_VAPID_PRIVATE_KEY

# ------------------------------------------------------------
# 前端（Vite）
# ------------------------------------------------------------
# dev server 允许的 Host（逗号分隔）；未配置仅允许 localhost/127.0.0.1
VITE_ALLOWED_HOSTS=
